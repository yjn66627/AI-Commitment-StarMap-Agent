{
  "appId": "com.yjn.aicommitmentstarmap.desktop",
  "productName": "AI承诺审计星图-智能体",
  "artifactName": "AI-Commitment-StarMap-${version}-Windows-x64-Setup.${ext}",
  "asar": true,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "runtime/**/*",
    "assets/icon.ico",
    "package.json",
    "!**/tests/**",
    "!**/node_modules/**/test/**",
    "!**/*.map",
    "!**/docs/**"
  ],
  "win": {
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/icon.ico",
    "executableName": "AI承诺审计星图-智能体",
    "verifyUpdateCodeSignature": true
  },
  "publish": null
}
