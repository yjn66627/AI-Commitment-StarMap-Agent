{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-commitment-constellation/b/synthetic-report-proposal-0.1.schema.json",
  "title": "阶段B独立合成报告输入提案；并非冻结V2.0真实报告接口",
  "description": "严格约定的演示报告契约。禁止将真实V2.0导出直接导入此输入；只能经过未来核验后的隔离映射层。JSON Schema之外须调用CrossRefValidator。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_version",
    "data_class",
    "project_key",
    "project_title",
    "source_documents",
    "evidence_records",
    "people",
    "commitments",
    "deadlines",
    "risks",
    "relationships",
    "reviews",
    "notices"
  ],
  "properties": {
    "report_version": {
      "const": "competition-report-proposal-0.1"
    },
    "data_class": {
      "const": "fully_synthetic_demo"
    },
    "project_key": {
      "$ref": "#/$defs/id"
    },
    "project_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_documents": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "evidence_records": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "people": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "commitments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "deadlines": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "notices": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/notice"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 85,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "key_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 50
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion",
        "review_state"
      ],
      "properties": {
        "assertion": {
          "enum": [
            "direct",
            "inference",
            "unknown"
          ]
        },
        "review_state": {
          "enum": [
            "not_required",
            "unreviewed",
            "pending",
            "confirmed",
            "rejected"
          ]
        },
        "review_key": {
          "$ref": "#/$defs/id"
        },
        "unknown_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "assertion": {
                "const": "unknown"
              }
            },
            "required": [
              "assertion"
            ]
          },
          "then": {
            "required": [
              "unknown_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "review_state": {
                "enum": [
                  "confirmed",
                  "rejected"
                ]
              }
            },
            "required": [
              "review_state"
            ]
          },
          "then": {
            "required": [
              "review_key"
            ]
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "evidence_keys",
        "assessment"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence_keys": {
          "$ref": "#/$defs/key_list"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator_quality"
      ],
      "properties": {
        "section": {
          "type": "string",
          "maxLength": 100
        },
        "paragraph_index": {
          "type": "integer",
          "minimum": 0
        },
        "line_start": {
          "type": "integer",
          "minimum": 0
        },
        "line_end": {
          "type": "integer",
          "minimum": 0
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        },
        "locator_quality": {
          "const": "exact"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "channel",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "channel": {
          "enum": [
            "meeting",
            "email",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "document_key",
        "location",
        "quotation"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "document_key": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "quotation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "subject_key",
        "object_key",
        "kind",
        "evidence_keys",
        "assessment"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "subject_key": {
          "$ref": "#/$defs/id"
        },
        "object_key": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "assigned_to",
            "evidenced_by",
            "due_on",
            "may_expose_to",
            "unknown"
          ]
        },
        "evidence_keys": {
          "$ref": "#/$defs/key_list"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "reviewer_key",
        "target",
        "decision",
        "recorded_at",
        "remark"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "reviewer_key": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "decision": {
          "enum": [
            "confirm",
            "reject"
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/date"
        },
        "remark": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key"
      ],
      "properties": {
        "kind": {
          "enum": [
            "node",
            "relation"
          ]
        },
        "key": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "MISSING_SOURCE",
            "MISSING_EVIDENCE",
            "DANGLING_REF",
            "UNSUPPORTED_RELATION",
            "REVIEW_PENDING",
            "REDACTED_SOURCE",
            "UNVERIFIED_OUTPUT",
            "UNKNOWN_VALUE",
            "SCHEMA_ERROR",
            "DUPLICATE_ID",
            "OTHER"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "related_key": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
